// GawJaay — schéma de données (cahier des charges §35).
//
// Choix techniques :
// - `provider = "sqlite"` pour le développement/test/CI (aucune infra requise, moteur réel).
//   Pour la production, passer à `provider = "postgresql"` et définir DATABASE_URL (voir docs/database.md).
// - Aucune énumération native ni champ Json : les statuts et listes sont stockés en String
//   (validés côté application via @gawjaay/shared). Cela garantit un comportement identique
//   entre SQLite et PostgreSQL.
// - Les montants sont des Int en FCFA (XOF, sans décimale).
// - Chaque table métier porte `organizationId` pour garantir l'isolation multi-tenant.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────── Identité & accès ───────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  fullName      String
  phone         String?
  // Vérification réelle du téléphone (OTP). Reste false tant qu'aucun code
  // n'a été effectivement validé : jamais positionné automatiquement.
  phoneVerified Boolean  @default(false)
  platformAdmin Boolean  @default(false) // SUPER_ADMIN GawJaay
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships       Membership[]
  refreshTokens     RefreshToken[]
  passwordResets    PasswordReset[]
  sales             Sale[]
  inventoryMovements InventoryMovement[]
  auditLogs         AuditLog[]
  customerProfile   Customer?
  orders            Order[]              @relation("OrderCustomerUser")
  priceHistory      PriceHistory[]
  phoneVerifications PhoneVerification[]
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Demande de vérification de téléphone par code (OTP). Fondation sans
 * fournisseur SMS : le code n'est JAMAIS livré automatiquement (aucun envoi
 * simulé). `status` reste PENDING tant qu'un code correct n'a pas été validé.
 * Limitation des tentatives via `attempts`.
 */
model PhoneVerification {
  id        String   @id @default(cuid())
  userId    String
  phone     String
  codeHash  String
  status    String   @default("PENDING") // PENDING | VERIFIED | EXPIRED | CANCELLED
  attempts  Int      @default(0)
  expiresAt DateTime
  verifiedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  phone       String?
  // Numéro WhatsApp public choisi par le commerçant (jamais déduit/inventé).
  whatsapp    String?
  email       String?
  address     String?
  city        String?
  region      String?
  country     String   @default("Sénégal")
  activity    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships   Membership[]
  stores        Store[]
  categories    Category[]
  suppliers     Supplier[]
  products      Product[]
  customers     Customer[]
  purchases     Purchase[]
  orders        Order[]
  couriers      Courier[]
  subscription  Subscription?
  auditLogs     AuditLog[]
  priceHistory  PriceHistory[]
}

model Membership {
  id            String   @id @default(cuid())
  organizationId String
  userId        String
  role          String // OWNER | ADMIN | MANAGER | VENDEUR | STOCK
  // Permissions fines (JSON en texte). Vide => permissions par défaut du rôle.
  permissions   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// ─────────────────────────── Boutiques ───────────────────────────

model Store {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String   @unique // /shop/:slug — globalement unique
  description    String?
  phone          String?
  address        String?
  city           String?
  region         String?
  latitude       Float?
  longitude      Float?
  isPublic       Boolean  @default(false) // vitrine publique activée
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  sales              Sale[]
  purchases          Purchase[]
  orders             Order[]

  @@index([organizationId])
  @@index([isPublic])
}

// ─────────────────────────── Catalogue ───────────────────────────

model Category {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  imageUrl       String?
  parentId       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]   @relation("CategoryTree")
  products     Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  address        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]
  purchases    Purchase[]

  @@index([organizationId])
}

model Product {
  id              String   @id @default(cuid())
  organizationId  String
  categoryId      String?
  supplierId      String?
  name            String
  sku             String
  description     String?
  imageUrl        String?
  // Photo durable stockée en base (data-URI base64) : survit aux redémarrages,
  // contrairement au filesystem éphémère de Render. `imageUrl` reste prioritaire
  // si un hébergement d'images externe est un jour branché.
  imageData       String?
  imageMime       String?
  packaging       String   @default("unite") // conditionnement : sac, carton, bidon…
  format          String? // ex. « 50 kg », « 12 bouteilles », « 5 L »
  purchasePrice   Int      @default(0)
  price           Int      @default(0) // prix de vente public
  promoPrice      Int? // prix promotionnel
  alertThreshold  Int      @default(0) // seuil d'alerte de stock
  isActive        Boolean  @default(true)
  marketplaceVisible Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?        @relation(fields: [categoryId], references: [id])
  supplier     Supplier?        @relation(fields: [supplierId], references: [id])
  variants     ProductVariant[]
  priceHistory PriceHistory[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([categoryId])
}

/**
 * Historique des changements de prix (lu depuis `field` : "purchasePrice" |
 * "price"). Chaque écriture de prix crée une ligne AVANT/APRÈS, ce qui permet
 * de répondre factuellement à « quel était le prix d'achat / de vente à cette
 * période ? ». N'écrit jamais dans les ventes déjà réalisées (celles-ci
 * conservent leurs propres instantanés SaleItem.unitPrice / unitCost).
 */
model PriceHistory {
  id             String   @id @default(cuid())
  organizationId String
  productId      String
  field          String // "purchasePrice" | "price"
  oldValue       Int?
  newValue       Int
  userId         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([productId, field, createdAt])
  @@index([organizationId])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  sku        String   @unique // SKU scannable (POS) — globalement unique
  name       String // ex. "Rouge / L", "Modèle standard"
  attributes String? // JSON texte {taille, couleur, ...}
  price      Int? // prix spécifique à la variante (sinon prix produit)
  imageUrl   String?
  imageData  String? // photo durable de la variante (data-URI base64)
  imageMime  String?
  lowStockThreshold Int @default(0) // seuil d'alerte propre à la variante (0 = seuil produit)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]
  purchaseItems      PurchaseItem[]
  orderItems         OrderItem[]

  @@index([productId])
}

// ─────────────────────────── Stock ───────────────────────────

model Inventory {
  id        String   @id @default(cuid())
  storeId   String
  variantId String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([storeId, variantId])
  @@index([variantId])
}

model InventoryMovement {
  id        String   @id @default(cuid())
  storeId   String
  variantId String
  type      String // ENTRY | SALE | ONLINE_ORDER | RETURN | TRANSFER_IN | TRANSFER_OUT | ADJUSTMENT | COUNT | INITIAL
  quantity  Int // signé : positif = entrée, négatif = sortie
  userId    String?
  reference String? // ex. saleId, orderId, purchaseId
  note      String?
  createdAt DateTime @default(now())

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id])

  @@index([storeId, variantId])
  @@index([createdAt])
}

// ─────────────────────────── Clients ───────────────────────────

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?  @unique // compte en ligne rattaché (optionnel)
  name           String
  phone          String?
  email          String?
  address        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])
  sales        Sale[]
  orders       Order[]

  @@index([organizationId])
}

// ─────────────────────────── Ventes (POS) ───────────────────────────

model Sale {
  id          String   @id @default(cuid())
  storeId     String
  customerId  String?
  userId      String? // vendeur
  subtotal    Int      @default(0)
  discount    Int      @default(0)
  total       Int      @default(0)
  status      String   @default("COMPLETED") // COMPLETED | REFUNDED
  refundedAt  DateTime?
  // Clé d'idempotence fournie par le client : empêche une double soumission
  // (double clic / retry réseau) de créer deux ventes. Unique par organisation
  // via une clé composite globale `storeId`+`clientRequestId` ci-dessous.
  clientRequestId String?
  createdAt   DateTime @default(now())

  store    Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?     @relation(fields: [customerId], references: [id])
  user     User?         @relation(fields: [userId], references: [id])
  items    SaleItem[]
  payments SalePayment[]

  @@unique([storeId, clientRequestId])
  @@index([storeId, createdAt])
  @@index([customerId])
}

model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  variantId String
  name      String // instantané du nom au moment de la vente
  quantity  Int
  unitPrice Int
  lineTotal Int
  // Instantané du prix d'achat AU MOMENT de la vente : garantit une marge
  // historique juste même si le prix d'achat du produit change plus tard.
  // Nul pour les ventes antérieures à cette colonne (fallback sur le prix produit).
  unitCost  Int?

  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([saleId])
}

model SalePayment {
  id        String   @id @default(cuid())
  saleId    String
  amount    Int
  method    String // CASH | WAVE | ORANGE_MONEY | CARD | CREDIT
  status    String   @default("SUCCESSFUL") // PENDING | SUCCESSFUL | FAILED | CANCELLED | REFUNDED
  provider  String? // prestataire externe si applicable (aucun connecté ici)
  reference String?
  createdAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// ─────────────────────────── Achats / Fournisseurs ───────────────────────────

model Purchase {
  id             String   @id @default(cuid())
  organizationId String
  supplierId     String?
  storeId        String // boutique de destination (réception)
  reference      String?
  status         String   @default("DRAFT") // DRAFT | ORDERED | RECEIVED | CANCELLED
  subtotal       Int      @default(0)
  total          Int      @default(0)
  receivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier?        @relation(fields: [supplierId], references: [id])
  store        Store            @relation(fields: [storeId], references: [id])
  items        PurchaseItem[]
  payments     PurchasePayment[]

  @@index([organizationId])
  @@index([supplierId])
}

model PurchaseItem {
  id         String @id @default(cuid())
  purchaseId String
  variantId  String
  quantity   Int
  unitCost   Int
  lineTotal  Int

  purchase Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@index([purchaseId])
}

model PurchasePayment {
  id         String   @id @default(cuid())
  purchaseId String
  amount     Int
  method     String   @default("CASH")
  status     String   @default("SUCCESSFUL")
  reference  String?
  createdAt  DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

// ─────────────────────────── Commandes en ligne ───────────────────────────

model Order {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String
  customerId     String?
  customerUserId String?
  channel        String   @default("ONLINE") // ONLINE (marketplace/boutique)
  status         String   @default("PENDING")
  subtotal       Int      @default(0)
  deliveryFee    Int      @default(0)
  total          Int      @default(0)
  customerName   String
  customerPhone  String
  deliveryAddress String?
  deliveryRegion  String?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id])
  customerUser User?         @relation("OrderCustomerUser", fields: [customerUserId], references: [id])
  items        OrderItem[]
  events       OrderEvent[]
  payments     OrderPayment[]
  delivery     Delivery?

  @@index([organizationId, status])
  @@index([storeId])
  @@index([customerUserId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  variantId String
  name      String
  quantity  Int
  unitPrice Int
  lineTotal Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  fromStatus String?
  toStatus   String
  userId     String?
  note       String?
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderPayment {
  id        String   @id @default(cuid())
  orderId   String
  amount    Int
  method    String
  status    String   @default("SUCCESSFUL")
  reference String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─────────────────────────── Livraison ───────────────────────────

model Courier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  type           String   @default("INTERNAL") // INTERNAL | PARTNER
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   Delivery[]

  @@index([organizationId])
}

model Delivery {
  id          String   @id @default(cuid())
  orderId     String   @unique
  courierId   String?
  status      String   @default("PENDING") // PENDING | ASSIGNED | IN_TRANSIT | DELIVERED | FAILED
  fee         Int      @default(0)
  address     String?
  phone       String?
  region      String?
  proofUrl    String?
  assignedAt  DateTime?
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier Courier? @relation(fields: [courierId], references: [id])

  @@index([courierId])
}

// ─────────────────────────── SaaS & audit ───────────────────────────

model Subscription {
  id             String   @id @default(cuid())
  organizationId String   @unique
  plan           String   @default("FREE") // FREE | STANDARD | PRO | BUSINESS
  status         String   @default("ACTIVE") // ACTIVE | SUSPENDED | CANCELLED
  startedAt      DateTime @default(now())
  renewsAt       DateTime?
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String // ex. "product.create", "sale.create", "auth.login"
  entity         String?
  entityId       String?
  meta           String? // JSON texte
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([action])
}
