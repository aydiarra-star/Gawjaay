# Variables d'environnement — GawJaay API (exemple)
# Copier en `.env` et adapter. NE JAMAIS committer de secrets réels.

# Base de données
# - dev/test/CI : SQLite via Prisma
DATABASE_URL="file:./prisma/dev.db"
# - production recommandée : PostgreSQL (changer le provider dans prisma/schema.prisma)
# DATABASE_URL="postgresql://gawjaay:motdepasse@localhost:5432/gawjaay"

NODE_ENV="development"
PORT=4000

# Secrets JWT (obligatoires en production, >= 32 caractères)
JWT_ACCESS_SECRET="dev-access-secret-change-me-at-least-32-chars"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-at-least-32-chars"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# CORS : origine autorisée du frontend (en production, exactement l'URL réelle)
FRONTEND_URL="http://localhost:5173"

# Paiements : aucun prestataire réel n'est connecté dans ce dépôt.
# PAYMENTS_MODE=disabled (défaut production) => les paiements en ligne répondent 503.
PAYMENTS_MODE="disabled"
