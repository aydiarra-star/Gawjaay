# Variables d'environnement — GawJaay API (exemple)
# Copier en `.env` et adapter. NE JAMAIS committer de secrets réels.

# Base de données
# - dev/test/CI/Docker : SQLite via Prisma
#   ⚠️ Prisma résout un chemin SQLite RELATIF depuis le dossier du schéma
#   (apps/api/prisma/) : `file:./dev.db` = apps/api/prisma/dev.db.
DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER="sqlite"
# - production recommandée : PostgreSQL managé (Render, Neon, Supabase, RDS…).
#   Définir alors DATABASE_PROVIDER="postgresql" et l'URL réelle :
# DATABASE_URL="postgresql://gawjaay:motdepasse@hote:5432/gawjaay?sslmode=require"
# DATABASE_PROVIDER="postgresql"

NODE_ENV="development"
PORT=4000
# Interface d'écoute : 0.0.0.0 derrière un proxy/hébergeur, 127.0.0.1 en local.
HOST="0.0.0.0"

# Secrets JWT (obligatoires en production, >= 32 caractères)
JWT_ACCESS_SECRET="dev-access-secret-change-me-at-least-32-chars"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-at-least-32-chars"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# CORS : origine autorisée du frontend (en production, exactement l'URL réelle)
FRONTEND_URL="http://localhost:5173"

# Paiements : aucun prestataire réel n'est connecté dans ce dépôt.
# PAYMENTS_MODE=disabled (défaut production) => les paiements en ligne répondent 503.
PAYMENTS_MODE="disabled"
