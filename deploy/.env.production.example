# GawJaay V2 — Variables de PRODUCTION (à fournir, JAMAIS committées)
# Copier vers backend/.env sur le VPS : cp deploy/.env.production.example backend/.env
# Générer les secrets : openssl rand -hex 32

NODE_ENV="production"
PORT=4000

# --- Base de données ---
# V2 actuelle : SQLite (fichier). PostgreSQL = travail d'adaptation documenté dans
# docs/V2_PRODUCTION_READINESS.md §C (dialecte SQL + driver). À fournir si PG retenu :
# DATABASE_URL="postgresql://<user>:<password>@<host>:5432/gawjaay"
DATABASE_URL="file:/var/lib/gawjaay/gawjaay.db"

# --- JWT (OBLIGATOIRE, 32+ octets aléatoires, NE PAS utiliser les défauts de dev) ---
JWT_ACCESS_SECRET="<openssl rand -hex 32>"
JWT_REFRESH_SECRET="<openssl rand -hex 32 DIFFÉRENT>"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# --- CORS ---
FRONTEND_URL="https://<votre-domaine>"

# --- Paiements (SANDBOX tant que pas de contrat officiel Wave / Orange Money) ---
# Ne JAMAIS mettre de clés de production sans contrat signé.
WAVE_API_KEY="<fourni par Wave — SANDBOX pour le pilote>"
WAVE_WEBHOOK_SECRET="<fourni par Wave — SANDBOX pour le pilote>"
OM_API_KEY="<fourni par Orange — SANDBOX pour le pilote>"
OM_WEBHOOK_SECRET="<fourni par Orange — SANDBOX pour le pilote>"

# --- Sentry (monitoring erreurs) — à créer sur sentry.io puis coller le DSN ---
SENTRY_DSN="<https://xxx@oXXX.ingest.sentry.io/XXX>"

# --- Backups S3 (optionnel mais recommandé) ---
AWS_S3_BUCKET="<bucket-backups>"
AWS_REGION="<eu-west-3>"
AWS_ACCESS_KEY_ID="<clé à provisioning limité s3:PutObject sur le bucket>"
AWS_SECRET_ACCESS_KEY="<secret>"
