# GawJaay V3 — Variables de PRODUCTION (à fournir, JAMAIS committées)
# Copier vers backend/.env sur le VPS : cp deploy/.env.production.example backend/.env
# Générer les secrets : openssl rand -hex 32

NODE_ENV="production"
PORT=4000

# --- Base de données — PostgreSQL OBLIGATOIRE en production ---
# Le moteur est choisi par DATABASE_URL (backend/src/lib/db.ts) :
#   postgresql://… → PostgreSQL (driver `pg`)  ← PRODUCTION
#   file:…         → SQLite                    ← development / tests / CI UNIQUEMENT
# ⚠️ Ne JAMAIS déployer en production avec un DATABASE_URL `file:` (SQLite).
# Créer la base, l'utilisateur et un mot de passe fort sur le VPS, privilèges minimaux.
DATABASE_URL="postgresql://<user>:<password>@127.0.0.1:5432/gawjaay"

# --- JWT (OBLIGATOIRE, 32+ octets aléatoires, NE PAS utiliser les défauts de dev) ---
JWT_ACCESS_SECRET="<openssl rand -hex 32>"
JWT_REFRESH_SECRET="<openssl rand -hex 32 DIFFÉRENT>"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# --- CORS ---
FRONTEND_URL="https://<votre-domaine>"

# --- Paiements mobiles : NOT CONNECTED TO PRODUCTION PAYMENT PROVIDER ---
# Aucun fournisseur de paiement de production (Wave, Orange Money, carte) n'est intégré dans ce dépôt.
#   PAYMENTS_MODE=disabled  → valeur par défaut en production : WAVE / ORANGE_MONEY / CARD répondent 503
#                             (`code: SERVICE_UNAVAILABLE`), l'UI n'affiche aucun bouton de paiement mobile,
#                             seul CASH (espèces, encaissement confirmé par le marchand via
#                             POST /payments/:id/confirm-cash) est réellement possible.
#   PAYMENTS_MODE=sandbox   → fournisseurs SIMULÉS (dev / tests / démo). L'API REFUSE DE DÉMARRER avec cette
#                             valeur quand NODE_ENV=production (fail-fast, backend/src/config/env.ts).
# Passer en production réelle = signer les contrats, implémenter un connecteur `PaymentProvider`
# (backend/src/modules/payments/service.ts), le couvrir par des tests, puis seulement renseigner les clés.
PAYMENTS_MODE="disabled"
# Clés fournisseurs : INUTILISÉES tant que PAYMENTS_MODE=disabled. Ne JAMAIS coller de clés réelles sans contrat signé.
WAVE_API_KEY=""
WAVE_WEBHOOK_SECRET=""
OM_API_KEY=""
OM_WEBHOOK_SECRET=""

# --- Sentry (monitoring erreurs) — à créer sur sentry.io puis coller le DSN ---
SENTRY_DSN="<https://xxx@oXXX.ingest.sentry.io/XXX>"

# --- Backups S3 (optionnel mais recommandé) ---
AWS_S3_BUCKET="<bucket-backups>"
AWS_REGION="<eu-west-3>"
AWS_ACCESS_KEY_ID="<clé à provisioning limité s3:PutObject sur le bucket>"
AWS_SECRET_ACCESS_KEY="<secret>"
